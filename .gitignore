# Build outputs
bin/*.gba
bin/*.gbc
bin/*.nds
bin/*.elf
bin/*.map

# C build artifacts
*.o
*.a
*.so
*.d

# Frontend build outputs
frontend-gba/*.gba
frontend-gba/*.elf
frontend-gba/*.map
frontend-gba/build/
frontend-gbc/*.gbc
frontend-gbc/*.elf
frontend-gbc/*.map
frontend-nds/*.nds
frontend-nds/*.elf
frontend-nds/*.map

# User-supplied frontend-gba fixtures (real Gen III .sav dumps — not
# committed; see frontend-gba/tests/fixtures/README.md).
frontend-gba/tests/fixtures/*.sav
frontend-gba/tests/fixtures/*.bin

# User-extracted Gen III sprite assets (output of tools/extract_sprites.py
# against a user-supplied ROM — never committed; the repo ships only the
# generic silhouette).
frontend-gba/graphics/sprites/

# Generated species->sprite_item* lookup (output of tools/gen_sprite_lookup.py;
# rebuilt by `make gba` so it tracks whatever BMPs live in graphics/sprites/).
frontend-gba/src/species_sprite_lookup.cpp

# Test runner binaries and output.  Each tests/test_<name>.c builds into
# a sibling tests/test_<name> ELF that gcc spits out into the source tree.
# Ignore the binaries but keep the .c sources.
libpksave/tests/*.out
libpksave/tests/test_runner
libpksave/tests/test_*
!libpksave/tests/test_*.c

# Claude Code agent scratch (temporary worktrees + per-session state — never
# meant to be tracked).  Subagent isolation worktrees land under
# .claude/worktrees/ and are scrubbed at session end; the dir as a whole is
# harness state, not project state.
.claude/

# Python bytecode (test harness uses python3; no virtualenv, so pyc lands
# wherever the scripts run).
__pycache__/
*.pyc

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
